# Masabaşı Oyun Kulübü — ortam değişkenleri
# Kopyala: cp .env.masabasi.example .env.masabasi

# JWT imzalama anahtarı (production'da güçlü bir değer girin)
MASABASI_JWT_SECRET=masabasi-change-me-in-prod

# CORS — production'da frontend domain'i girin
MASABASI_CORS_ORIGIN=*

# Frontend build'i için backend URL (tarayıcının ulaşacağı adres)
MASABASI_API_BASE_URL=http://localhost:8090/api/v1

# AI Oyun Ustası için Anthropic API anahtarı (opsiyonel)
# https://console.anthropic.com
CLAUDE_API_KEY=your-anthropic-api-key-here

# Adapter: "claude" (default)
GAMEMASTER_MODE=claude
